# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins (frontend URL)
CORS_ORIGIN=http://localhost:5173
# Comma-separated HTTP methods allowed in cross-origin requests
CORS_METHODS=GET,POST,OPTIONS
# Allow cookies/credentials in cross-origin requests (requires explicit origins, not "*").
# Not needed by the frontend: authentication uses the Authorization header.
CORS_CREDENTIALS=false

# Database (SQLite file path, relative to the backend folder)
DATABASE_URL="file:./dev.db"

# Authentication (use a long random string, at least 16 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d
