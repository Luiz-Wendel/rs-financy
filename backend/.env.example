# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database (SQLite file path, relative to the prisma folder)
DATABASE_URL="file:./dev.db"

# Authentication (use a long random string, at least 16 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d
